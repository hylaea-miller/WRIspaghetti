```{r}
library(sf)
library(jsonlite)

# Config
cog_path <- "data/sb_dem_cog.tif"
stac_root <- "stac"
item_id <- "sb_dem"

dir.create(file.path(stac_root, "items"), recursive = TRUE, showWarnings = FALSE)

# Read data
r <- read_stars(cog_path)

# Get bbox in EPSG:4326
sf_use_s2(FALSE)
bb <- st_bbox(r)
poly_4326 <- st_transform(st_as_sfc(bb), 4326)
bb_4326 <- st_bbox(poly_4326)
bbox_4326 <- as.numeric(c(bb_4326["xmin"], bb_4326["ymin"], bb_4326["xmax"], bb_4326["ymax"]))

# Build Item
item <- list(
  stac_version = "1.0.0",
  type = "Feature",
  id = item_id,
  bbox = bbox_4326,
  properties = list(datetime = "2026-01-25T00:00:00Z"),
  assets = list(
    data = list(
      href = cog_path,
      type = "image/tiff; application=geotiff; profile=cloud-optimized",
      roles = list("data")))
)
```


```{r}
# Save your STAC item as a JSON file
write_json(item, file.path(stac_root, "items", paste0(item_id, ".json")), #Build the file path 
           auto_unbox = TRUE, # Converts single-element vectors to scalars in JSON
           pretty = TRUE) # Format with indentation (human-readable)

cat("Wrote: stac/items/sb_dem.json\n")
```


