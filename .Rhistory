# 2. Read the COG
tile <- read_stars("data/sb_dem_cog.tif")
# 3. Define bounding box for small Santa Barbara area
bbox_sb <- st_bbox(c(xmin = -119.72, ymin = 34.42,
xmax = -119.68, ymax = 34.44),
crs = st_crs(4326))
# 4. Crop to bounding box
sb_area <- st_crop(tile, bbox_sb)
# 5. Query by elevation values (DEM domains)
# Example: get only elevations between 0-100m
low_elevation <- sb_area
low_elevation[low_elevation < 0 | low_elevation > 100] <- NA
View(low_elevation)
library(sf)
library(jsonlite)
# --- Config ---
cog_path <- "data/sb_dem_cog.tif"
stac_root <- "stac"
item_id <- "sb_dem"
dir.create(file.path(stac_root, "items"), recursive = TRUE, showWarnings = FALSE)
# --- Read with stars ---
r <- read_stars(cog_path)
# --- Get bbox in EPSG:4326 ---
sf_use_s2(FALSE)
bb <- st_bbox(r)
poly_4326 <- st_transform(st_as_sfc(bb), 4326)
bb_4326 <- st_bbox(poly_4326)
bbox_4326 <- as.numeric(c(bb_4326["xmin"], bb_4326["ymin"], bb_4326["xmax"], bb_4326["ymax"]))
# --- Build Item ---
item <- list(
stac_version = "1.0.0",
type = "Feature",
id = item_id,
bbox = bbox_4326,
properties = list(datetime = "2026-01-25T00:00:00Z"),
assets = list(
data = list(
href = cog_path,
type = "image/tiff; application=geotiff; profile=cloud-optimized",
roles = list("data")
)
)
)
# --- Write ---
write_json(item, file.path(stac_root, "items", paste0(item_id, ".json")),
auto_unbox = TRUE, pretty = TRUE)
cat("Wrote: stac/items/sb_dem.json\n")
str(item)
item(plot)
plot(item)
# 1. Check the JSON file was created
file.exists("stac/items/sb_dem.json")
# 2. Read and view the STAC item
item <- read_json("stac/items/sb_dem.json")
str(item)  # See structure
# 3. Check key fields
item$bbox  # Should show [xmin, ymin, xmax, ymax] in lon/lat
item$assets$data$href  # Should be "data/sb_dem_cog.tif"
item$properties$datetime  # Should be "2026-01-25T00:00:00Z"
# 4. Verify the COG path is correct
file.exists(item$assets$data$href)
# 5. Pretty print
cat(toJSON(item, auto_unbox = TRUE, pretty = TRUE))
plot(sb_area)
plot(tile)
plot(low_elevation)
plot(sb_area)
# 1. Define YOUR area of interest (small part of Santa Barbara)
aoi <- st_bbox(c(xmin = -119.72, ymin = 34.42,
xmax = -119.68, ymax = 34.44),
crs = 4326)
# 2. Read STAC item
item <- read_json("stac/items/sb_dem.json")
# 3. Check if STAC item intersects your AOI
item_bbox <- st_bbox(c(xmin = item$bbox[[1]],
ymin = item$bbox[[2]],
xmax = item$bbox[[3]],
ymax = item$bbox[[4]]),
crs = 4326)
intersects <- st_intersects(st_as_sfc(aoi),
st_as_sfc(item_bbox),
sparse = FALSE)[1,1]
# 4. If intersects, load and crop to YOUR AOI
if (intersects) {
dem <- read_stars(item$assets$data$href)
dem_aoi <- st_crop(dem, aoi)
plot(dem_aoi, main = "Your AOI from STAC")
} else {
cat("No intersection with AOI\n")
}
# --- Write ---
write_json(item, file.path(stac_root, "items", paste0(item_id, ".json")),
auto_unbox = TRUE, pretty = TRUE)
cat("Wrote: stac/items/sb_dem.json\n")
